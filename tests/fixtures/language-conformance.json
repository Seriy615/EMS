    {
      "id": "branch",
      "source": "fn test(flag:Boolean)->Number {if flag {return 1;} else {return 1/0;}}",
      "inputs": {
        "flag": true
      },
      "expected": {
        "value": 1
      }
    },
    {
      "id": "loop-order",
      "source": "fn test()->Number {let mut n=0;let mut total=0;while n<10 {n=n+1;if n==3 {continue;}if n==6 {break;}total=total+n;}return total;}",
      "inputs": {},
      "expected": {
        "value": 12
      }
    },
    {
      "id": "recursive",
      "source": "fn factorial(n:Number)->Number {if n<=1 {return 1;}return n*factorial(n-1);} fn test(n:Number)->Number {return factorial(n);}",
      "inputs": {
        "n": 5
      },
      "expected": {
        "value": 120
      }
    },
    {
