    {
      "id": "channel-backpressure",
      "source": "async fn produce(s:Stream<Number>)->Number {await stream.send(s,2);await stream.send(s,3);stream.close(s);return 4;} async fn test()->Number {let s:Stream<Number>=stream.channel(1);let producer=produce(s);let mut total=0;for await n in s {total=total+n;}return total+(await producer);}",
      "inputs": {},
      "expected": {
        "value": 9
      }
    },
    {
      "id": "stream-zero",
