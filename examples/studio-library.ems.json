{
  "schemaVersion": "ems-studio-project/1",
  "id": "libraryExample",
  "name": "Массив → текст",
  "ir": {
    "schemaVersion": "ems-ir/1",
    "profile": "ems-effects-finite/1",
    "id": "analyze",
    "version": "1.0.0",
    "inputs": [
      {
        "name": "values",
