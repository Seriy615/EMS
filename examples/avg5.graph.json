{
  "schemaVersion": "0.1",
  "id": "demo.AverageOfFiveArithmetic",
  "version": "0.1.0",
  "inputs": { "times": { "type": "NumberArray", "description": "Exactly five positive durations in seconds (WCA penalty and DNF rules NOT included)" } },
  "output": { "type": "Number", "description": "Unrounded arithmetic average excluding one minimum and maximum" },
  "nodes": [
    { "id": "total", "uses": "core.sum", "args": { "values": { "input": "times" } } },
    { "id": "lowest", "uses": "core.min", "args": { "values": { "input": "times" } } },
    { "id": "highest", "uses": "core.max", "args": { "values": { "input": "times" } } },
    { "id": "remove_low", "uses": "core.sub", "args": { "a": { "node": "total" }, "b": { "node": "lowest" } } },
    { "id": "remove_high", "uses": "core.sub", "args": { "a": { "node": "remove_low" }, "b": { "node": "highest" } } },
    { "id": "average", "uses": "core.div", "args": { "a": { "node": "remove_high" }, "b": { "literal": 3 } } }
  ],
  "returns": { "node": "average" }
}
