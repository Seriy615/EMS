@Counter {value:Number=@Initial;+Change(delta:Number)->Number graph { @self::value::read #read {} @core::add #add {a <= #read;b <= input::delta;} @self::value::write #write {value <= #add;} @std::program::Result #out {value <= #write;} + #read; #read.next ~> #add.enter; #add.next ~> #write.enter; #write.next ~> #out.enter;}? nonnegative=@Guard;} @Counter #left; @Counter #right {value:@Initial;} @Initial()->Number graph { @std::program::Result #out {value:5;} + #out;} @Guard(value:Number)->Boolean graph { @std::number::greaterEqual #compare {a <= input::value;b:0;} @std::program::Result #out {value <= #compare;} + #compare; #compare.next ~> #out.enter;} @UI.Column #root { @UI.Text #count {text <= left.value as number;} @UI.Button #up {text:"+";} @UI.Button #fail {text:"fail";} } up.clicked ~> left::Change(delta:2); fail.clicked ~> left::Change(delta:-9);
