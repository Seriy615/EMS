{
  "schemaVersion": "0.1",
  "id": "example.double_average",
  "version": "0.1.0",
  "inputs": { "times": { "type": "NumberArray" } },
  "output": { "type": "Number" },
  "nodes": [
    { "id": "avg", "uses": "demo.AverageOfFiveArithmetic", "args": { "times": { "input": "times" } } },
