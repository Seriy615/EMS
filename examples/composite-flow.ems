@math::Step(z:Number,a:Number)->Number {
    let mut value=z;
    value=value+a;
    return value;
}

@math::Wrap(x:Number)->Number {
    return math.Step(x,2);
}

@app::Main()->Number {
    let mut i=0;
    let mut total=0;
    while i<3 {
        total=total+math.Wrap(i);
        i=i+1;
    }
    return total+math.Wrap(10);
}
