{
  "name": "ems-language-foundation",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "EMS reference semantics, contract graphs and standalone compiler proof of concept",
  "engines": {"node": ">=22"},
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify": "node tools/verify.mjs",
    "conformance": "node tools/conformance.mjs",
    "browser:verify": "node tools/browser-conformance.mjs",
    "browser:test": "node --test tests/browser/*.test.mjs",
    "export:portable": "node tools/export-portable.mjs",
    "demo": "node tools/ems.mjs run examples/avg5.graph.json '{\"times\":[12.4,11.85,13.2,12.1,14]}'",
    "validate": "node tools/ems.mjs validate examples/avg5.graph.json",
    "build:demo": "node tools/ems.mjs build examples/avg5.graph.json --out dist/avg5.mjs",
    "seal:demo": "node tools/ems.mjs seal examples/avg5.graph.json --out dist/avg5-atomic",
    "text:demo": "node tools/ems.mjs text-run examples/avg5.ems '{\"times\":[12.4,11.85,13.2,12.1,14]}'",
    "studio": "node tools/serve.mjs"
  },
  "license": "UNLICENSED"
}
