{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ems.local/schemas/graph.schema.json",
  "title": "EMS M0 Reference Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "inputs",
    "output",
    "nodes",
    "returns"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "0.1",
        "ems-contract-graph/1"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "Number",
              "NumberArray",
              "Boolean",
              "String"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "output": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "Number",
            "NumberArray",
            "Boolean",
            "String"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "uses",
          "args"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "uses": {
            "type": "string"
          },
          "args": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[-a-zA-Z0-9_.]+$"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[-a-zA-Z0-9_.]+$"
      },
      "uniqueItems": true
    },
    "sequence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "returns": {
      "$ref": "#/$defs/ref"
    },
    "interfaceRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "ref": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "node"
          ],
          "properties": {
            "node": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": [
                "string",
                "number",
                "boolean",
                "array"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "ems-contract-graph/1"
          }
        }
      },
      "then": {
        "required": [
          "interfaceRef"
        ]
      },
      "else": {
        "not": {
          "required": [
            "interfaceRef"
          ]
        }
      }
    }
  ]
}
