{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ems.local/schemas/ir.schema.json",
  "title": "EMS initial typed semantic IR v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "ems-ir/1"
    },
    "profile": {
      "enum": [
        "ems-core-finite/1",
        "ems-effects-finite/1",
        "ems-contract-core-finite/1",
        "ems-contract-effects-finite/1"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "enum": [
              "Number",
              "NumberArray",
              "Boolean",
              "String"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "Number",
            "NumberArray",
            "Boolean",
            "String"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "contract": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "port": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "value": {
                  "$ref": "#/$defs/reference"
                }
              },
              "required": [
                "port",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "type": {
            "enum": [
              "Number",
              "NumberArray",
              "Boolean",
              "String"
            ]
          },
          "policy": {
            "type": "object",
            "properties": {
              "effects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[-a-zA-Z0-9_.]+$"
                },
                "uniqueItems": true
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[-a-zA-Z0-9_.]+$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "effects",
              "capabilities"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "contract",
          "arguments",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "result": {
      "$ref": "#/$defs/reference"
    },
    "policy": {
      "type": "object",
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[-a-zA-Z0-9_.]+$"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[-a-zA-Z0-9_.]+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "effects",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "sequence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "requirements": {
      "type": "object",
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[-a-zA-Z0-9_.]+$"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[-a-zA-Z0-9_.]+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "effects",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "interfaceRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "profile",
    "id",
    "version",
    "inputs",
    "output",
    "operations",
    "result"
  ],
  "additionalProperties": false,
  "$defs": {
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "input"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "node"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "type": {
              "const": "Number"
            },
            "value": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "const": "-0"
                }
              ]
            }
          },
          "required": [
            "kind",
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "type": {
              "const": "NumberArray"
            },
            "value": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "const": "-0"
                  }
                ]
              }
            }
          },
          "required": [
            "kind",
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "type": {
              "const": "Boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "type": {
              "const": "String"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "type",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "enum": [
              "ems-effects-finite/1",
              "ems-contract-effects-finite/1"
            ]
          }
        }
      },
      "then": {
        "required": [
          "policy",
          "sequence",
          "requirements"
        ],
        "properties": {
          "operations": {
            "items": {
              "required": [
                "policy"
              ]
            }
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "policy"
              ]
            },
            {
              "required": [
                "sequence"
              ]
            },
            {
              "required": [
                "requirements"
              ]
            }
          ]
        },
        "properties": {
          "operations": {
            "items": {
              "not": {
                "required": [
                  "policy"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "enum": [
              "ems-contract-core-finite/1",
              "ems-contract-effects-finite/1"
            ]
          }
        }
      },
      "then": {
        "required": [
          "interfaceRef"
        ]
      },
      "else": {
        "not": {
          "required": [
            "interfaceRef"
          ]
        }
      }
    }
  ]
}
