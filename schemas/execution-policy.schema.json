{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ems.local/schemas/execution-policy.schema.json",
  "title": "EMS explicit execution grants",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "capabilities": { "$ref": "#/$defs/names" },
    "allowedEffects": { "$ref": "#/$defs/names" }
  },
  "$defs": {
    "names": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[-a-zA-Z0-9_.]+$" },
      "uniqueItems": true
    }
  }
}
