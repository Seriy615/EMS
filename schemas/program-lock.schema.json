{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ems.local/schemas/program-lock.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "ems-program-lock/1"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "program": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contracts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "atomic",
              "composite",
              "resource"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "implementation": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "intrinsic",
                  "artifact",
                  "composite",
                  "binding"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "version",
          "kind",
          "sha256",
          "implementation"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dependencies": {
            "type": "array",
            "maxItems": 10000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "sha256",
          "dependencies"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "target",
    "program",
    "contracts",
    "artifacts"
  ],
  "additionalProperties": false
}
