{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ems.local/schemas/contract-binding.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "ems-contract-binding/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[-A-Za-z0-9_.]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "interface": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[-A-Za-z0-9_.]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[-A-Za-z0-9_.]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "pattern": "^[-A-Za-z0-9_.]+$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "determinism": {
      "enum": [
        "deterministic",
        "unspecified"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "interface",
    "implementation",
    "targets",
    "determinism"
  ],
  "additionalProperties": false
}
