{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ems.local/schemas/studio-collection-project.schema.json",
  "title": "EMS Studio typed collection project v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "graph",
    "inputs",
    "canvas",
    "references",
    "contracts",
    "collections",
    "ir"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ems-studio-project/3"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "graph": {
      "$ref": "#/$defs/graph"
    },
    "inputs": {
      "type": "object",
      "maxProperties": 100
    },
    "canvas": {
      "$ref": "studio-project.schema.json#/properties/canvas"
    },
    "references": {
      "$ref": "#/$defs/references"
    },
    "contracts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/workspace"
      }
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "operation",
          "callback"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[-A-Za-z0-9_.]+$"
          },
          "version": {
            "const": "1.0.0"
          },
          "operation": {
            "enum": [
              "map",
              "filter"
            ]
          },
          "callback": {
            "$ref": "#/$defs/pin"
          }
        }
      }
    },
    "ir": {
      "oneOf": [
        {
          "$ref": "ir.schema.json"
        },
        {
          "$ref": "control-ir.schema.json"
        }
      ]
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "Number",
            "Boolean",
            "String",
            "NumberArray"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "literal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "Number"
            },
            "value": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "const": "-0"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "NumberArray"
            },
            "value": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "const": "-0"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "String"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "Boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node"
          ],
          "properties": {
            "node": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "$ref": "#/$defs/literal"
            }
          }
        }
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "version",
        "inputs",
        "output",
        "nodes",
        "returns"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "$ref": "#/$defs/type"
          }
        },
        "output": {
          "$ref": "#/$defs/type"
        },
        "nodes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "uses",
              "args"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "uses": {
                "type": "string"
              },
              "args": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/ref"
                }
              }
            }
          }
        },
        "returns": {
          "$ref": "#/$defs/ref"
        },
        "sequence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph",
        "inputs",
        "canvas",
        "references"
      ],
      "properties": {
        "graph": {
          "$ref": "#/$defs/graph"
        },
        "inputs": {
          "type": "object",
          "maxProperties": 100
        },
        "canvas": {
          "$ref": "studio-project.schema.json#/properties/canvas"
        },
        "references": {
          "$ref": "#/$defs/references"
        }
      }
    }
  }
}
