{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ems.invalid/schemas/source-project.schema.json",
  "title": "EMS source project v1",
  "description": "Data-only compiler input. The implementation also validates entry membership, unique paths, UTF-8 aggregate size and canonical project-relative paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entry", "files"],
  "properties": {
    "schemaVersion": {"const": "ems-source-project/1"},
    "entry": {"$ref": "#/$defs/path"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "source"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "source": {"type": "string", "maxLength": 1048576}
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string", "minLength": 1, "maxLength": 240,
      "pattern": "^[A-Za-z0-9_ .-]+(?:/[A-Za-z0-9_ .-]+)*$",
      "not": {"pattern": "(?:^|/)\\.\\.?(?:/|$)"}
    }
  }
}
